# ===================== Vendor App =====================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่อง/องค์กรของคุณ

# ---------- MongoDB ----------
MONGODB_URI=mongodb://admin:secret@localhost:27017/
MONGODB_DB=epicor_procurement
USERS_COLLECTION=app_users

# ---------- ข้อมูลสรุปที่คำนวณล่วงหน้า ----------
# หน้าภาพรวมใช้ตัวเลขที่คำนวณเก็บไว้ แล้วคำนวณใหม่เมื่อเกินอายุนี้ (ชั่วโมง)
# ข้อมูลต้นทางเปลี่ยนเฉพาะตอนรัน ETL วันละครั้งจึงพอ
SNAPSHOT_TTL_HOURS=24
SNAPSHOT_WARM_ON_START=true

# ---------- เงื่อนไขบนหน้าเสนอราคาของผู้ขาย ----------
# เว้นว่าง = ใช้เงื่อนไขมาตรฐานที่ระบบเตรียมไว้ · คั่นแต่ละข้อด้วย |
# เลื่อนเวอร์ชันทุกครั้งที่แก้เนื้อหา เพื่อให้รู้ว่าผู้ขายรับทราบฉบับไหน
PORTAL_TERMS_VERSION=1.0
PORTAL_TERMS=

# ---------- App ----------
APP_NAME=Vendor App API
APP_ENV=development
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------- JWT session ----------
# สร้างค่าสุ่ม: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false

# ---------- Microsoft Entra ID (Azure AD) ----------
# หาได้จาก Azure Portal > Microsoft Entra ID > App registrations > (แอปของคุณ)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# ต้องตรงกับ Redirect URI (Web) ที่ลงทะเบียนไว้ใน Azure Portal เป๊ะ ๆ
# ต้องตรงกับที่ลงทะเบียนไว้ใน Azure เป๊ะ ๆ (scheme + host + port + path ห้ามมี / ปิดท้าย)
# แนะนำให้ใช้ origin เดียวกับที่เปิดเว็บ เพราะ Next ส่งต่อ /api ไปหลังบ้านให้อยู่แล้ว
MS_REDIRECT_URI=http://localhost:3000/api/auth/ms/callback

# ---------- เปิดให้เข้าจากภายนอกผ่าน ngrok ----------
# อย่าแก้สี่ค่านี้เอง ใช้  .\run-ngrok.ps1  เติมให้ทีเดียวพร้อมกัน (เลิกใช้: -Revert)
#   FRONTEND_URL      = https://xxxx.ngrok-free.app        ลิงก์ที่ส่งให้ผู้ขายจะใช้ค่านี้
#   CORS_ORIGINS      = http://localhost:3000,https://xxxx.ngrok-free.app
#   MS_REDIRECT_URI   = https://xxxx.ngrok-free.app/api/auth/ms/callback  (ต้องเพิ่มใน Azure ด้วย)
#   COOKIE_SECURE     = true
MS_SCOPES=openid profile email User.Read

# ---------- อีเมลที่ให้เป็น admin อัตโนมัติ (คั่นด้วย ,) ----------
INITIAL_ADMIN_EMAILS=
