# =============================================================
# Vendor App — ไฟล์ที่ไม่ต้องเก็บเข้า git
#
# หลักคิด: เก็บเฉพาะ "สิ่งที่เขียนเอง" — โค้ด เอกสาร ไฟล์ตัวอย่างเล็ก ๆ
# ส่วนของที่ "สร้างใหม่ได้" (build, cache, venv) หรือ "เป็นข้อมูลจริง"
# (ไฟล์จาก Epicor, ไฟล์ที่ผู้ขายอัปโหลด, รหัสผ่าน) ไม่เข้า repo
# =============================================================

# ---------------- Python / backend ----------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------- Node / Next.js / frontend ----------------
node_modules/
.next/
out/
build/
.turbo/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# หมายเหตุ: frontend/AGENTS.md กับ frontend/CLAUDE.md ถูกเขียนใหม่โดย `next dev` ทุกครั้ง
# แต่ "ควร commit" ไม่ใช่ ignore — ถ้า ignore ไว้ มันจะโผล่เป็นไฟล์ใหม่ทุกเครื่องที่รัน

# ---------------- ความลับ / การตั้งค่าเฉพาะเครื่อง ----------------
# ไฟล์ .example เก็บไว้เป็นแบบ ส่วนไฟล์จริงที่มีรหัสผ่าน/สตริงต่อ MongoDB ไม่เข้า repo
.env
.env.*
!.env.example
!.env.*.example

# ---------------- ข้อมูลจริง ไม่ใช่โค้ด ----------------
# ไฟล์ Excel ที่ export มาจาก Epicor — เป็นข้อมูลราคาและผู้ขายของจริง
# ขนาดใหญ่ เปลี่ยนทุกครั้งที่ export และไม่ควรอยู่ในที่ที่แชร์กันได้ง่าย
Data/
data/

# ไฟล์ที่ผู้ขายอัปโหลด/ไฟล์ที่ระบบสร้าง ย้ายไปเก็บใน MongoDB แล้ว (services/filestore.py)
# โฟลเดอร์นี้เหลือแค่ของเก่าที่รอย้ายด้วย scripts/migrate_uploads_to_mongo.py
backend/uploads/

# ไฟล์ที่ระบบสร้างเพื่อดาวน์โหลด (งบประมาณ / ใบขอราคาเป็น Excel)
exports/
*.tmp.xlsx

# ---------------- ผลพลอยได้จากการทดสอบ ----------------
# ภาพหน้าจอที่ Playwright ถ่ายไว้ตอนรันเทสต์ — สร้างใหม่ได้ทุกครั้งที่รัน
_shots/
frontend/_shots/

# ข้อมูลจำลองที่ backend/tests/seed_epicor.py ดัมป์ไว้ให้ testserver.py โหลด
*.pkl
epicor_seed.pkl

# ---------------- ของเหลือจากการส่งงาน / ของชั่วคราว ----------------
# แพ็กเกจที่ส่งไฟล์เข้ามาทีละรอบ ไม่ใช่ส่วนหนึ่งของโปรเจกต์
_*.tgz
_to_delete/
_to_delete_*/
_old_v*/
_removed/

# ---------------- Windows / Excel / เครื่องมือแก้โค้ด ----------------
# Excel สร้างไฟล์ล็อกชื่อขึ้นต้นด้วย ~$ ทุกครั้งที่เปิดไฟล์ BOM ค้างไว้
~$*
Thumbs.db
ehthumbs.db
desktop.ini
*.lnk
.DS_Store
.vscode/
.idea/
*.swp

# ---------------- log ที่รันทิ้งไว้ ----------------
*.log
nohup.out
