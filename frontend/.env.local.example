# ปลายทางที่ Next.js จะ proxy /api/* และ /files/* ไปให้
# ใช้ localhost (ไม่ใช่ 127.0.0.1) เพื่อให้ cookie ใช้ร่วมกับ backend ได้
BACKEND_URL=http://localhost:8000

# ถ้าองค์กรบังคับออกเน็ตผ่าน corporate proxy ให้ใส่ localhost ใน NO_PROXY ด้วย
# ไม่งั้น rewrites จะวิ่งออกไปที่ proxy แทนที่จะเข้า backend ในเครื่อง
# HTTP_PROXY=http://proxy.company.local:8080
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1

# โดเมนที่อนุญาตให้เข้า dev server ได้นอกจาก localhost (คั่นด้วยจุลภาค)
# โดเมนของ ngrok ทุกแบบถูกอนุญาตไว้ให้แล้วใน next.config.mjs
# ค่านี้ไว้ใส่โดเมนอื่น เช่น static domain ของตัวเอง — .\run-ngrok.ps1 เติมให้อัตโนมัติ
# DEV_ORIGINS=xxxx.ngrok-free.app
